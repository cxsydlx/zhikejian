{
  "app": {
    "signingConfigs": [
      "material": {
          // ==================== 本地签名配置 ====================
          // ⚠️ 下面是**占位值**，不是可用配置。
          //    真值（桌面绝对路径 + DevEco 加密的密码密文）**不入库**：
          //    密文本身解不开（依赖你本机 DevEco 凭证库），但公开后会泄露
          //    你的用户名、桌面目录结构、签名材料文件名。
          //    拷贝本文件为 build-profile.json5 再填自己的值即可。
          //
          //    每个开发者在本机复制一份并填自己的值：
          //      1. DevEco Studio → File → Project Structure → Signing Configs
          //      2. 勾选「Automatically generate signature」用自动签名（最省事，
          //         但**代理提醒功能需要手动签名 + AGC 审核过的 Profile**）
          //      3. 或点「手动签名」填自己的 .p12 / .p7b / .cer 与明文密码
          //      4. 存盘后 DevEco 会把明文加密成密文写回本文件
          //
          //    ⛔ 私钥（.p12）**永远不要提交**，见仓库根 .gitignore
          "storeFile": "<你的 .p12 绝对路径>",
          "storePassword": "<DevEco 生成的密文>",
          "keyAlias": "<别名>",
          "keyPassword": "<DevEco 生成的密文>",
          "signAlg": "SHA256withECDSA",
          "profile": "<你的 .p7b 绝对路径>",
          "certpath": "<你的 .cer 绝对路径>"
        }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": false
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "capabilities": [
      {
        "bundleName": "com.zhikejian.app",
        "config": [
          {
            "capability": "com.huawei.service.liveView.entry",
            "name": "Live View Kit"
          }
        ]
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}